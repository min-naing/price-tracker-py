MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/price-tracker
MONGODB_DATABASE=your_mongo_database_name

TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

ATLAS_PUBLIC_KEY=your_atlas_public_key
ATLAS_PRIVATE_KEY=your_atlas_private_key
ATLAS_GROUP_ID=your_atlas_project_id

B2_KEY_ID=your_b2_key_id
B2_APP_KEY=your_b2_app_key
B2_BUCKET_NAME=your_b2_bucket_name
B2_ENDPOINT=your_b2_endpoint

# Scrapper Config
SCRAPER_NAVIGATION_TIMEOUT_MS=30000
SCRAPER_ELEMENT_TIMEOUT_MS=5000

SCRAPER_MAX_RATE_LIMIT_RETRIES=5
SCRAPER_RATE_LIMIT_BACKOFF_SECONDS=10

SCRAPER_MAX_CONSECUTIVE_SCRAPE_FAILURES=3
SCRAPER_PAGE_FAILURE_BACKOFF_SECONDS=3

SCRAPER_FAIL_RATE_THRESHOLD=0.3
SCRAPER_MIN_ITEMS_BEFORE_RATE_CHECK=5